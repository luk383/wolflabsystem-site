{
  "it": "  <div class=\"tool\" id=\"passaggi\">\n    <h2>Passaggi in maratona</h2>\n    <p class=\"small\">Tempi di passaggio a ritmo costante, da stampare o copiare su una banda da polso.</p>\n    <div class=\"pace-card\" data-paceband>\n  <div class=\"pace-top\">\n    <label for=\"tool-band\">Obiettivo in maratona</label>\n    <input class=\"time-input\" id=\"tool-band\" value=\"3:30\" inputmode=\"numeric\" autocomplete=\"off\" aria-describedby=\"tool-band-foot\">\n  </div>\n  <p class=\"pace-big\" aria-live=\"polite\"><span data-pace>4:59</span><small>/km</small></p>\n  <div class=\"band\" aria-label=\"Passaggi a ritmo costante\"></div>\n  <p class=\"band-foot\" id=\"tool-band-foot\"></p>\n</div>\n  </div>\n\n  <div class=\"tool\" id=\"pace-tool\">\n    <h2>Ritmi di allenamento</h2>\n    <p class=\"small\">Ritmi espressi in percentuale della velocità maratona, l'approccio usato da molti allenatori della scuola italiana e da John Davis. Sono un punto di partenza: adattali a come ti senti.</p>\n    <div class=\"fields\">\n      <div class=\"field\"><label for=\"target\">Tempo obiettivo (h:mm)</label><input id=\"target\" value=\"3:30\" inputmode=\"numeric\" autocomplete=\"off\"></div>\n    </div>\n    <div class=\"results\" id=\"pace-out\" aria-live=\"polite\"></div>\n  </div>\n\n  <div class=\"tool\" id=\"carboidrati\">\n    <div id=\"carb-tool\">\n    <h2>Carboidrati in gara</h2>\n    <p class=\"small\">Basato sulle linee guida dell'American College of Sports Medicine e sugli studi di Asker Jeukendrup. <a href=\"/articoli/carboidrati-maratona/\">Leggi l'articolo</a></p>\n    <div class=\"fields\">\n      <div class=\"field\"><label for=\"race-time\">Tempo di gara (h:mm)</label><input id=\"race-time\" value=\"3:30\" inputmode=\"numeric\" autocomplete=\"off\"></div>\n      <div class=\"field\"><label for=\"weight\">Peso (kg)</label><input id=\"weight\" type=\"number\" value=\"70\" min=\"30\" max=\"200\" inputmode=\"decimal\"></div>\n      <div class=\"field\"><label for=\"gel\">Grammi per gel</label><input id=\"gel\" type=\"number\" value=\"25\" min=\"5\" max=\"100\"><p class=\"hint\">Lo trovi sull'etichetta</p></div>\n      <div class=\"field\"><label for=\"rate\">Carboidrati all'ora: <span id=\"rate-val\"></span></label><input class=\"range\" id=\"rate\" type=\"range\" min=\"30\" max=\"90\" step=\"5\" value=\"60\"></div>\n    </div>\n    <div class=\"results\" id=\"carb-out\" aria-live=\"polite\"></div>\n    </div>\n  </div>",
  "en": "  <div class=\"tool\" id=\"splits\">\n    <h2>Marathon splits</h2>\n    <p class=\"small\">Even-pace split times, to print or copy onto a wrist band.</p>\n    <div class=\"pace-card\" data-paceband>\n  <div class=\"pace-top\">\n    <label for=\"tool-band\">Marathon goal</label>\n    <input class=\"time-input\" id=\"tool-band\" value=\"3:30\" inputmode=\"numeric\" autocomplete=\"off\" aria-describedby=\"tool-band-foot\">\n  </div>\n  <p class=\"pace-big\" aria-live=\"polite\"><span data-pace>4:59</span><small>/km</small></p>\n  <div class=\"band\" aria-label=\"Even-pace splits\"></div>\n  <p class=\"band-foot\" id=\"tool-band-foot\"></p>\n</div>\n  </div>\n\n  <div class=\"tool\" id=\"pace-tool\">\n    <h2>Training paces</h2>\n    <p class=\"small\">Paces as a percentage of marathon speed, the approach used by many coaches of the Italian school and by John Davis. They are a starting point: adjust to how you feel.</p>\n    <div class=\"fields\">\n      <div class=\"field\"><label for=\"target\">Goal time (h:mm)</label><input id=\"target\" value=\"3:30\" inputmode=\"numeric\" autocomplete=\"off\"></div>\n    </div>\n    <div class=\"results\" id=\"pace-out\" aria-live=\"polite\"></div>\n  </div>\n\n  <div class=\"tool\" id=\"carbs\">\n    <div id=\"carb-tool\">\n    <h2>Race-day carbohydrate</h2>\n    <p class=\"small\">Based on American College of Sports Medicine guidelines and Asker Jeukendrup's research. <a href=\"/en/articles/marathon-carbohydrates/\">Read the article</a></p>\n    <div class=\"fields\">\n      <div class=\"field\"><label for=\"race-time\">Race time (h:mm)</label><input id=\"race-time\" value=\"3:30\" inputmode=\"numeric\" autocomplete=\"off\"></div>\n      <div class=\"field\"><label for=\"weight\">Weight (kg)</label><input id=\"weight\" type=\"number\" value=\"70\" min=\"30\" max=\"200\" inputmode=\"decimal\"></div>\n      <div class=\"field\"><label for=\"gel\">Grams per gel</label><input id=\"gel\" type=\"number\" value=\"25\" min=\"5\" max=\"100\"><p class=\"hint\">Check the label</p></div>\n      <div class=\"field\"><label for=\"rate\">Carbs per hour: <span id=\"rate-val\"></span></label><input class=\"range\" id=\"rate\" type=\"range\" min=\"30\" max=\"90\" step=\"5\" value=\"60\"></div>\n    </div>\n    <div class=\"results\" id=\"carb-out\" aria-live=\"polite\"></div>\n    </div>\n  </div>"
}
